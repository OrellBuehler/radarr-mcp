{
  "name": "@orellbuehler/radarr-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Radarr: library management, searches, queue, calendar, history and configuration for AI agents.",
  "type": "module",
  "bin": {
    "radarr-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:update": "bash scripts/update-openapi.sh",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "radarr",
    "movies",
    "media-management",
    "servarr",
    "arr",
    "claude",
    "ai-agents",
    "llm",
    "ai"
  ],
  "author": "Orell Bühler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrellBuehler/radarr-mcp.git"
  },
  "homepage": "https://github.com/OrellBuehler/radarr-mcp#readme",
  "bugs": {
    "url": "https://github.com/OrellBuehler/radarr-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
